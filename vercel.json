{
  "rewrites": [
    {
      "source": "/footwear/:project",
      "destination": "/footwear/:project.html"
    },
    {
      "source": "/accessories/:project",
      "destination": "/accessories/:project.html"
    },
    {
      "source": "/masks/:project",
      "destination": "/masks/:project.html"
    },
    {
      "source": "/experimentalpage",
      "destination": "/experimentalpage.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

